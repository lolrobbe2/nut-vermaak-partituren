@namespace nut_vermaak_partituren.frontend.pages.Components

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- BlazorBootstrap CSS -->
    <link href="@Assets["_content/Blazor.Bootstrap/blazor.bootstrap.css"]"
          rel="stylesheet" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- Blazor Web App -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <!-- BlazorBootstrap JavaScript -->
    <script src="@Assets["_content/Blazor.Bootstrap/blazor.bootstrap.js"]"></script>
</body>

</html>
