@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Sign in</PageTitle>

<div class="container min-vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-sm p-4 w-100" style="max-width: 26rem;">

        <div class="text-center mb-4">
            <h2 class="fw-bold">Welcome back</h2>
            <p class="text-muted">
                Sign in to continue to your account.
            </p>
        </div>

        <div class="d-grid gap-3">

            <Button Color="ButtonColor.Light"
                    Type="ButtonType.Link"
                    To="@GoogleLoginUrl">
                <i class="bi bi-google me-2"></i>
                Continue with Google
            </Button>

            <Button Color="ButtonColor.Light"
                    Type="ButtonType.Link"
                    To="@MicrosoftLoginUrl">
                <i class="bi bi-microsoft me-2"></i>
                Continue with Microsoft
            </Button>

        </div>

        <div class="text-center text-muted mt-4">
            <small>
                <i class="bi bi-shield-lock me-1"></i>
                Secure authentication
            </small>
        </div>

    </div>
</div>

@code {
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string GoogleLoginUrl => BuildLoginUrl("google");

    private string MicrosoftLoginUrl => BuildLoginUrl("microsoft");

    private string BuildLoginUrl(string provider)
    {
        string destination = string.IsNullOrWhiteSpace(ReturnUrl)
            ? "/"
            : ReturnUrl;

        return $"/auth/login/{provider}?returnUrl={Uri.EscapeDataString(destination)}";
    }
}
